{
  "_kb_section": {
    "description": "=== 知识库 ===",
    "type": "text",
    "invisible": true
  },
  "kb_name": {
    "description": "知识库名字",
    "type": "string",
    "default": "长期记忆",
    "hint": "必须和注入侧 astrbot_plugin_memory_recall 的同名配置一致。"
  },
  "_embedding_section": {
    "description": "=== Embedding 来源 ===",
    "type": "text",
    "invisible": true
  },
  "_embedding_note": {
    "description": "保存后插件会热重载，并按这里的设置创建/更新 memory_layer_embedding，再绑定记忆知识库。已经一致就跳过。",
    "type": "text",
    "invisible": true
  },
  "embedding_mode": {
    "description": "Embedding 来源",
    "type": "string",
    "options": ["kb", "cloud", "local"],
    "labels": ["跟随知识库", "云端 API", "本机服务"],
    "subtitles": [
      "不接管，使用知识库当前配置的 embedding provider",
      "OpenAI 兼容的 /v1/embeddings 接口",
      "本机 Ollama 或 OpenAI 兼容的 embedding 服务"
    ],
    "default": "kb",
    "hint": "跟随知识库时不会修改任何 provider / 知识库绑定。"
  },
  "_cloud_section": {
    "description": "=== 云端 API（embedding_mode=cloud 时生效）===",
    "type": "text",
    "invisible": true
  },
  "cloud_api_base": {
    "description": "云端 API Base",
    "type": "string",
    "default": "",
    "hint": "例如 https://api.openai.com/v1；带不带 /v1 都会自动归一。"
  },
  "cloud_api_key": {
    "description": "云端 API Key",
    "type": "string",
    "default": "",
    "secret": true,
    "hint": "只保存在本机配置里，不会回显。留空表示沿用已保存的 Key。"
  },
  "cloud_model": {
    "description": "云端 Embedding 模型",
    "type": "string",
    "default": "text-embedding-3-small"
  },
  "cloud_dimensions": {
    "description": "云端向量维度",
    "type": "int",
    "default": 0,
    "hint": "0 表示保存后自动探测；探测结果会写回这里。"
  },
  "_local_section": {
    "description": "=== 本机服务（embedding_mode=local 时生效）===",
    "type": "text",
    "invisible": true
  },
  "local_host": {
    "description": "本机服务地址",
    "type": "string",
    "default": "127.0.0.1",
    "hint": "容器部署时 127.0.0.1 是 AstrBot 容器自身；宿主机服务填 host.docker.internal。"
  },
  "local_port": {
    "description": "本机服务端口",
    "type": "int",
    "default": 11434,
    "slider": {"min": 1, "max": 65535, "step": 1}
  },
  "local_api": {
    "description": "本机接口类型",
    "type": "string",
    "options": ["ollama", "openai"],
    "labels": ["Ollama（/api/embed）", "OpenAI 兼容（/v1/embeddings）"],
    "default": "ollama"
  },
  "local_model": {
    "description": "本机 Embedding 模型",
    "type": "string",
    "default": "bge-m3"
  },
  "local_dimensions": {
    "description": "本机向量维度",
    "type": "int",
    "default": 0,
    "hint": "0 表示保存后自动探测；探测结果会写回这里。"
  },
  "_apply_section": {
    "description": "=== 应用策略 ===",
    "type": "text",
    "invisible": true
  },
  "embedding_timeout": {
    "description": "请求超时（秒）",
    "type": "int",
    "default": 60,
    "slider": {"min": 5, "max": 300, "step": 5}
  },
  "create_kb_if_missing": {
    "description": "知识库不存在时自动创建",
    "type": "bool",
    "default": true,
    "hint": "关闭后，找不到知识库只会打错误日志，不会自动建库。"
  },
  "force_rebind": {
    "description": "允许同维度换模型",
    "type": "bool",
    "default": false,
    "hint": "默认拒绝换模型：不同模型即使维度相同也不在同一向量空间。维度不同永远拒绝。"
  }
}
